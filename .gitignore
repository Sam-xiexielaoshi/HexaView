
# ==========================================
# HexaView - Git Ignore
# ==========================================

# CMake build directories
build/
cmake-build-*/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
build.ninja
.ninja_deps
.ninja_log

# Compiled binaries and object files
*.o
*.obj
*.a
*.so
*.dll
*.exe
*.out

# Debugging and crash dumps
core
core.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db

# Temporary test files
*.tmp
